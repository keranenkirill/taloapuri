# Taloapuri – local configuration.
# Copy this file to `.env` (it is git-ignored). The app, Alembic, the scripts and the tests
# read `.env` automatically. The passwords below are for the local Docker database only.

# Environment: local | test | staging | production.
# The passwordless email login works only in local and test.
TALOAPURI_ENV=local

# The app connects with a role that does NOT own the tables, so row-level security always applies.
TALOAPURI_DATABASE_URL=postgresql+psycopg://taloapuri_app:local-dev-only@localhost:5432/taloapuri

# Migrations and dev scripts use the table-owner role.
TALOAPURI_MIGRATION_DATABASE_URL=postgresql+psycopg://taloapuri_owner:local-dev-only@localhost:5432/taloapuri

# Database tests (`pytest -m db`) use a separate database. Leave these out to skip DB tests.
TEST_DATABASE_URL=postgresql+psycopg://taloapuri_app:local-dev-only@localhost:5432/taloapuri_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://taloapuri_owner:local-dev-only@localhost:5432/taloapuri_test

# --- AI features (optional) -------------------------------------------------------------
# Every AI question, tender draft and offer comparison is a paid Anthropic API call.
# Get a key at https://console.anthropic.com → API Keys. Never commit a real key.
TALOAPURI_AI_ENABLED=false
ANTHROPIC_API_KEY=
TALOAPURI_AI_MODEL=claude-haiku-5-5
# Cost limits: monthly budget per housing company (USD) and chat questions per user per day.
TALOAPURI_AI_MONTHLY_BUDGET_USD=5.0
TALOAPURI_AI_DAILY_MESSAGES_PER_USER=20
